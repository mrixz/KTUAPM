{
  "scheme": "2019",
  "version": "2019-v1",
  "title": "KTU 2019 Scheme Activity Points Regulation",
  "description": "Official rules for KTU B.Tech & B.Arch 2019 Regulation Activity Points (100 points for regular, 75 points for lateral entry)",
  "academicRequirements": {
    "regular": {
      "requiredPoints": 100,
      "maximumPoints": 100,
      "admissionYearMin": 2019,
      "admissionYearMax": 2023,
      "joiningSemester": 1,
      "mandatoryCredits": 2,
      "description": "4-Year Regular B.Tech under 2019 Regulation (Minimum 100 activity points, 2 credits on pass/fail basis)"
    },
    "lateral": {
      "requiredPoints": 75,
      "maximumPoints": 75,
      "admissionYearMin": 2020,
      "admissionYearMax": 2024,
      "joiningSemester": 3,
      "mandatoryCredits": 2,
      "description": "Lateral Entry joining 3rd Semester with 2019-2023 batches (Minimum 75 activity points)"
    }
  },
  "levelDefinitions": {
    "I": "College Events",
    "II": "Zonal Events",
    "III": "State / University Events",
    "IV": "National Events",
    "V": "International Events"
  },
  "approvalDocuments": {
    "a": "Certificate",
    "b": "Letter from Authorities",
    "c": "Appreciation recognition letter",
    "d": "Documentary evidence",
    "e": "Legal Proof",
    "f": "Others (specify)"
  },
  "categories": [
    {
      "id": "national_initiatives",
      "code": "NAT",
      "name": "National Initiatives",
      "description": "National Cadet Corps (NCC) and National Service Scheme (NSS) participation and achievements",
      "categoryCap": {
        "regular": 80,
        "lateral": 80
      },
      "subcategories": ["NCC", "NSS"]
    },
    {
      "id": "sports_games",
      "code": "SPT",
      "name": "Sports & Games",
      "description": "Sports and Games participation and winning at College, Zonal, State/University, National and International levels",
      "categoryCap": {
        "regular": 80,
        "lateral": 80
      },
      "subcategories": ["Sports", "Games", "Athletics", "Football", "Cricket", "Basketball", "Badminton", "Table Tennis", "Volleyball", "Chess", "Swimming"]
    },
    {
      "id": "cultural_activities",
      "code": "CUL",
      "name": "Cultural Activities",
      "description": "Music, Performing arts, and Literary arts participation and winning across Levels I to V",
      "categoryCap": {
        "regular": 80,
        "lateral": 80
      },
      "subcategories": ["Music", "Performing arts", "Literary arts", "Dance", "Drama", "Fine Arts", "Debate", "Elocution", "Creative Writing"]
    },
    {
      "id": "professional_initiatives",
      "code": "PRO",
      "name": "Professional Self Initiatives",
      "description": "Tech Fest, MOOC with assessment, Professional Societies, Conference/STTP at IITs/NITs, Paper/Poster presentations, Internships, Industrial Visits, Foreign Language Skills",
      "categoryCap": null,
      "subcategories": [
        "Tech Fest",
        "Tech Quiz",
        "MOOC",
        "Professional Societies",
        "Conference",
        "STTP",
        "Workshop",
        "Paper Presentation",
        "Poster Presentation",
        "Industrial Training",
        "Internship",
        "Industrial Visit",
        "Exhibition Visit",
        "Foreign Language Skill"
      ]
    },
    {
      "id": "entrepreneurship_innovation",
      "code": "ENT",
      "name": "Entrepreneurship and Innovation",
      "description": "Startups, Patents (Filed/Published/Approved/Licensed), Prototypes, Product Awards, Innovative Technologies, Venture Capital, Startup Employment, Societal Innovations",
      "categoryCap": {
        "regular": 80,
        "lateral": 80
      },
      "subcategories": [
        "Startup",
        "Patent",
        "Prototype",
        "Product Award",
        "Innovative Technology",
        "Venture Capital",
        "Startup Employment",
        "Societal Innovation"
      ]
    },
    {
      "id": "leadership_management",
      "code": "LDR",
      "name": "Leadership & Management",
      "description": "Leadership roles in student professional societies, college associations, festivals/technical events, hobby clubs, and elected student representatives",
      "categoryCap": {
        "regular": 40,
        "lateral": 40
      },
      "subcategories": [
        "Professional Society Chapter",
        "College Association Chapter",
        "Festival & Technical Events",
        "Hobby Clubs",
        "Elected Student Representatives"
      ]
    }
  ],
