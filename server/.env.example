# ==============================================================================
# KTU Activity Points Platform - Backend Environment Variables (Server)
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Frontend Origins (CORS)
# In production on Render, set this to your frontend Render Static Site URL:
# Example: FRONTEND_URL=https://ktuapm.onrender.com
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:4173

# MongoDB Atlas Connection
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/ktu-activity-points?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/ktu-activity-points

# Authentication Secrets
# Generate a strong 64-char random string in production
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Google Gemini API (AI Document Understanding)
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
CONFIDENCE_THRESHOLD=0.75

# Persistent Certificate Storage Provider
# Options:
# - 'local'      : Local filesystem storage (development only, saved to UPLOAD_DIR)
# - 'gridfs'     : MongoDB GridFS (Recommended for Render - zero extra setup, uses MongoDB Atlas!)
# - 'cloudinary' : Cloudinary CDN / storage
# - 's3'         : AWS S3 or S3-compatible storage
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads

# Cloudinary Configuration (Only required if STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AWS / S3 Configuration (Only required if STORAGE_PROVIDER=s3 or cloud)
AWS_BUCKET_NAME=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT=
