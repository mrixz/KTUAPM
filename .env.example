# ==============================================================================
# KTU Activity Points Platform - Root Environment Variables Template
# ==============================================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:4173

# Database (MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/ktu-activity-points

# Authentication Secret
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Google Gemini AI (Backend only - never expose to frontend)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
CONFIDENCE_THRESHOLD=0.75

# Persistent Certificate Storage
# Options: 'local' (dev), 'gridfs' (Render production default via MongoDB Atlas), 'cloudinary', 's3'
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads

# Cloudinary (Optional, if STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend Environment Variable (Used by Vite build)
VITE_API_URL=http://localhost:5000/api